+			const char *const _mq = getenv("MB_H264_MIN_QP");
+			const int _minqp = (_mq != NULL && atoi(_mq) > 0) ? atoi(_mq) : 16;
+			SET_OPTION(V4L2_CID_MPEG_VIDEO_H264_MIN_QP,			_minqp);
